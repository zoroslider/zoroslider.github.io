Options -Indexes

<FilesMatch "\.json$">
  Require all denied
</FilesMatch>

<FilesMatch "\.php$">
  Require all granted
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
</IfModule>
